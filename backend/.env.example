# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
DATABASE_URL=sqlite:///./escrowpilot.db
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com

# Payments: mock (offline) or sandbox (PayPal sandbox, test money only)
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PUBLIC_APP_URL=http://localhost:5173

# AI: offline (no key) or gemini (free tier key from Google AI Studio)
AI_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
CORS_ORIGINS=http://localhost:5173

# Fault rulings wait this long so either side can appeal once (0 = apply at once)
COOLING_OFF_HOURS=48
DUPLICATE_DOC_CHECK=true
# ADMIN_EMAIL may list two or more addresses, comma separated: a second admin decides appeals
